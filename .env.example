# Optional: AI-generated product-category recommendations (variant A).
# Any OpenAI-compatible endpoint works, e.g. Featherless. Without these, the app uses rule-based ranking.
# Copy to .env.local (git-ignored) — never commit real keys, never prefix with NEXT_PUBLIC_.
AI_BASE_URL=https://api.featherless.ai/v1
AI_API_KEY=
AI_MODEL=
# Optional: per-attempt timeout in milliseconds (default 45000).
AI_TIMEOUT_MS=
